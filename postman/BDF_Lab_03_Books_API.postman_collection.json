{
  "info": {
    "_postman_id": "bdf-lab-03-books-rest-api",
    "name": "BDF Lab 3: Books REST API (S. Kiran Teja - 252U1R8083)",
    "description": "Postman test suite for Backend Development Fundamentals Lab 3 covering RESTful CRUD, query parameters, sorting, price filtering, validation, and error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Success Cases - Query & CRUD",
      "item": [
        {
          "name": "GET All Books (Default: limit=10, offset=0, order_by=id ASC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains data array', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.limit).to.eql(10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books by Search (search_q=JavaScript)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=JavaScript",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [{ "key": "search_q", "value": "JavaScript" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('All returned books contain search keyword in title', function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(book) {",
                  "        pm.expect(book.title.toLowerCase()).to.include('javascript');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books Sorted (order_by=price&order=DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Books are sorted descending by price', function () {",
                  "    var json = pm.response.json();",
                  "    for (var i = 0; i < json.data.length - 1; i++) {",
                  "        pm.expect(json.data[i].price).to.be.at.least(json.data[i+1].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books Filtered by Price Range (min_price=20&max_price=45)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=20&max_price=45",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "20" },
                { "key": "max_price", "value": "45" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Books fall strictly within price range 20-45', function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(book) {",
                  "        pm.expect(book.price).to.be.within(20, 45);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books Pagination (limit=3&offset=2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=3&offset=2",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "2" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Limit is 3 and offset is 2', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.at.most(3);",
                  "    pm.expect(json.offset).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Single Book by ID (ID=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Book ID matches 1', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create New Book (201 Created)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Building Microservices with Node.js\",\n  \"author\": \"David Gonzalez\",\n  \"price\": 36.99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Book object returned with ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.title).to.eql('Building Microservices with Node.js');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT Update Book by ID (200 OK)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Eloquent JavaScript (Updated 4th Ed)\",\n  \"author\": \"Marijn Haverbeke\",\n  \"price\": 34.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Updated title matches', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.title).to.eql('Eloquent JavaScript (Updated 4th Ed)');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE Book by ID (200 OK)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/3",
              "host": ["{{baseUrl}}"],
              "path": ["books", "3"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Success message returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('deleted successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Failure & Validation Cases",
      "item": [
        {
          "name": "GET Non-existent Book ID (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });",
                  "pm.test('Error message present', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Invalid ID Format (400 Bad Request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/invalid-id",
              "host": ["{{baseUrl}}"],
              "path": ["books", "invalid-id"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
