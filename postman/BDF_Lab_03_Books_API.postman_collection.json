                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Invalid book ID');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Reject Missing Title (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Uncle Bob\",\n  \"price\": 45.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error message specifies title is required', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Title is required');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Reject Missing Author (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A Book with No Author\",\n  \"price\": 20.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error message specifies author is required', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Author is required');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Reject Non-Numeric Price (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Valid Title\",\n  \"author\": \"Valid Author\",\n  \"price\": \"free_or_string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error message specifies numeric price requirement', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Price is required');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT Non-existent Book ID (404 Not Found)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Non Existent\",\n  \"author\": \"Nobody\",\n  \"price\": 10.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE Non-existent Book ID (404 Not Found)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Invalid Price Filter min_price > max_price (400 Bad Request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=100&max_price=20",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "100" },
                { "key": "max_price", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Message clarifies min_price cannot be greater than max_price', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('min_price cannot be greater than max_price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
